# Discord Bot Token (required)
# Your Discord bot token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# Vultr API Key (required)
# Your Vultr API key from Vultr account settings
VULTR_API_KEY=your_vultr_api_key_here

# Legacy Vultr Snapshot ID (optional)
# User-facing create flows use the allowlisted snapshots in src/config/snapshots.js.
# Keep this only for fallback/admin paths that still need an environment default.
VULTR_SNAPSHOT_ID=your_snapshot_id_here

# Vultr Firewall Group ID (REQUIRED)
# UUID of the firewall group to attach to new instances
# Servers without firewall are automatically destroyed for security
VULTR_FIREWALL_GROUP_ID=your_firewall_group_id_here

# Vultr Region (optional)
# Region code for new instances (default: dfw - Dallas)
# See https://www.vultr.com/api/#tag/region for available regions
VULTR_REGION=dfw

# Vultr Plan (optional)
# Instance plan for new instances (default: vc2-1c-1gb - 1 CPU, 1GB RAM)
# See https://www.vultr.com/api/#tag/plans for available plans
VULTR_PLAN=vc2-1c-1gb

# Discord Guild ID (optional but recommended for immediate testing)
# Your Discord server ID - enables immediate command registration instead of waiting 1 hour
# Right-click your Discord server → "Copy Server ID" (requires Developer Mode enabled)
DISCORD_GUILD_ID=your_server_id_here

# Admin User IDs (optional)
# Comma-separated Discord user IDs who can create snapshots
ADMIN_USER_IDS=123456789,987654321

# Self-Destruct Timer Settings (optional)
# Servers auto-destroy after timer expires; users can extend with "Insert Coin"
SELF_DESTRUCT_INITIAL_MINUTES=180
SELF_DESTRUCT_COIN_MINUTES=180

# XLink Kai account assignment (optional, required for automatic XLink login)
# Private JSON file, not committed:
# {"accounts":[{"xtag":"example","password":"example"}]}
XLINK_ACCOUNTS_FILE=./secrets/xlink-accounts.json
XLINK_ASSIGNMENTS_FILE=./data/xlink-assignments.json
# Private arena password applied inside restored game servers
XLINK_PRIVATE_ARENA_PASSWORD=lan

# Selkies central OAuth proxy (optional)
# Requires DNS: *.dedi.halo2stats.org -> 45.76.27.186
SELKIES_CENTRAL_PROXY_ENABLED=0
SELKIES_OAUTH_ENABLED=0
SELKIES_DOMAIN=dedi.halo2stats.org
SELKIES_URL_TEMPLATE=https://{serverHost}.dedi.halo2stats.org
SELKIES_PROXY_SOURCE_IP=45.76.27.186
SELKIES_ROUTES_FILE=./data/selkies-routes.json

# Discord OAuth for Selkies (required when SELKIES_OAUTH_ENABLED=1)
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://auth.dedi.halo2stats.org/oauth/discord/callback
SELKIES_AUTH_PUBLIC_URL=https://auth.dedi.halo2stats.org
SELKIES_AUTH_COOKIE_DOMAIN=.dedi.halo2stats.org
SELKIES_AUTH_COOKIE_SECRET=
SELKIES_AUTH_SESSION_SECONDS=604800

# Exclusion Settings (optional)
# Exclude specific instances or snapshots from bot management
EXCLUDE_INSTANCE_ID=
EXCLUDE_SNAPSHOT_ID=
